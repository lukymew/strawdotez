# Função para centralizar mensagem de forma automática
center_message() {
    local message="$1"
    local clean_message
    printf -v clean_message '%b' "$message"
    shopt -s extglob
    clean_message=${clean_message//$'\e['+([0-9;])m/}
    local termwidth="${COLUMNS:-$(stty size < /dev/tty 2>/dev/null | cut -d' ' -f2)}"
    : "${termwidth:=80}"
    local padlen=$(( (termwidth - ${#clean_message}) / 2 ))
    (( padlen < 0 )) && padlen=0
    local padding
    printf -v padding '%*s' "$padlen" ''
    echo -e "$padding$message"
}

# Função para imprimir texto com margens laterais fixas
# uso: space <largura_margem> <texto>
space() {
    local margin="${1:-2}"
    local text="$2"
    local pad
    printf -v pad '%*s' "$margin" ''
    printf '%s%s%s\n' "$pad" "$text" "$pad"
}

