# --- his ---
# Busca no histórico de comandos por múltiplos termos combinados.
# uso: his consulta1 consulta2 ... | ex: his ssh 192
function his() {
    local commandlog
    commandlog=$(history | grep -oE "[a-zA-Z]{1}.*" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | sort | uniq)
    for var in "$@"; do
        commandlog=$(echo "$commandlog" | grep -i "$var")
    done
    echo "$commandlog"
}

# --- xtop ---
# Lista os N comandos mais usados no histórico (padrão: 10).
# uso: xtop [N]
function xtop() {
    local N=${1:-10}
    history | awk '{a[$2]++ } END{for(i in a){print a[i] " " i}}' | sort -rn | head -n "$N"
}

