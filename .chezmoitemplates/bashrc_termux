# --- command_not_found_handle ---
# Hook do bash: quando um comando não existe, sugere o pacote pkg correspondente no Termux.
# Reaproveita as cores já definidas na seção de Colors do bashrc.
command_not_found_handle() {
    local cmd="$1"

    printf "%bComando não encontrado:%b %s%b\n" "$blue" "$red" "$cmd" "$rst"

    case "$cmd" in
        adb|fastboot)
            printf "%bPacote disponível:%b\n" "$green" "$rst"
            printf "  • pkg install android-tools\n"
            ;;
        git|curl|wget|python|node|npm|php|java|gcc|g++)
            printf "%bPacote disponível:%b\n" "$green" "$rst"
            printf "  • pkg install %s\n" "$cmd"
            ;;
        docker|kubectl|terraform)
            printf "%bPacote não disponível no Termux%b\n" "$yellow" "$rst"
            printf "  • Use proot-distro para Linux completo\n"
            ;;
        *)
            printf "%bVerifique pacotes disponíveis:%b\n" "$yellow" "$rst"
            printf "  • pkg search %s\n" "$cmd"
            ;;
    esac
    return 127
}

# --- cd ---
# Sobrescreve o cd padrão para listar o conteúdo do diretório automaticamente após entrar.
# uso: cd [diretório]
cd() {
    if [ "$1" == ".." ]; then
        builtin cd .. && ls
    elif [ -n "$1" ]; then
        builtin cd "$1" && ls
    else
        builtin cd && ls
    fi
}

# --- backup-bashrc ---
# Cria uma cópia de backup do .bashrc atual com a data no nome, mantendo só os 5 mais recentes.
# uso: backup-bashrc
function backup-bashrc() {
    cp ~/.bashrc ~/.bashrc.backup."$(date +%Y%m%d-%H%M%S)"
    echo "Backup do .bashrc criado!"
    ls -t ~/.bashrc.backup.* 2>/dev/null | tail -n +6 | xargs -r rm --
}

# --- restore-bashrc ---
# Restaura o .bashrc a partir do backup mais recente e recarrega a sessão.
# uso: restore-bashrc
function restore-bashrc() {
    local latest_backup
    latest_backup=$(ls -t ~/.bashrc.backup.* 2>/dev/null | head -n1)
    if [ -n "$latest_backup" ]; then
        cp "$latest_backup" ~/.bashrc
        source ~/.bashrc
        echo ".bashrc restaurado de: $latest_backup"
    else
        echo "Nenhum backup encontrado!"
    fi
}

