}

# --- cd ---
# Sobrescreve o cd padrão para listar o conteúdo do diretório automaticamente após entrar.
# uso: cd [diretório]
cd() {
    if [ "$1" == ".." ]; then
        builtin cd .. && ls
    elif [ -n "$1" ]; then
        builtin cd "$1" && ls
    else
        builtin cd && ls
    fi
}

# --- backup-bashrc ---
# Cria uma cópia de backup do .bashrc atual com a data no nome, mantendo só os 5 mais recentes.
# uso: backup-bashrc
function backup-bashrc() {
    cp ~/.bashrc ~/.bashrc.backup."$(date +%Y%m%d-%H%M%S)"
    echo "{{ template "t" (list . "bk_created") }}"
    ls -t ~/.bashrc.backup.* 2>/dev/null | tail -n +6 | xargs -r rm --
}

# --- restore-bashrc ---
# Restaura o .bashrc a partir do backup mais recente e recarrega a sessão.
# uso: restore-bashrc
function restore-bashrc() {
    local latest_backup
    latest_backup=$(ls -t ~/.bashrc.backup.* 2>/dev/null | head -n1)
    if [ -n "$latest_backup" ]; then
        cp "$latest_backup" ~/.bashrc
        source ~/.bashrc
        echo "{{ template "t" (list . "rs_from") }}"
    else
        echo "{{ template "t" (list . "rs_none") }}"
    fi
}

