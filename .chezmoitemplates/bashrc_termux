# --- genpasswd ---
# Gera uma senha aleatória alfanumérica (padrão: 32 caracteres).
# uso: genpasswd [tamanho]
function genpasswd() {
    local PWDLEN=${1:-32}
    tr -dc 'A-Za-z0-9_' </dev/urandom | head -c "$PWDLEN"
    echo
}

# --- genpin ---
# Gera um código PIN numérico aleatório (padrão: 4 dígitos).
# uso: genpin [tamanho]
function genpin() {
    local PINLEN=${1:-4}
    tr -dc '0-9' </dev/urandom | head -c "$PINLEN"
    echo
}

# --- rot13 ---
# Aplica a cifra de César (ROT-13) em texto via stdin ou em um arquivo.
# uso: rot13 [arquivo]
function rot13() {
    if [ $# = 0 ]; then
        tr "[a-m][n-z][A-M][N-Z]" "[n-z][a-m][N-Z][A-M]"
    else
        tr "[a-m][n-z][A-M][N-Z]" "[n-z][a-m][N-Z][A-M]" < "$1"
    fi
}

