# --- atop ---
# Mostra as threads de um processo em tempo real via top -H.
# uso: atop <nome-processo>
function atop() {
    [ -z "$1" ] && { echo "uso: atop <nome-processo>" >&2; return; }
    local pids
    pids=$(pgrep -d, "$1")
    [ -z "$pids" ] && { echo "processo não encontrado: $1" >&2; return; }
    top -H -p "$pids"
}

