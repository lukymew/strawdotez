# --- @ip-locator ---
# Consulta informações de geolocalização/ISP de um ou mais IPs via ipinfo.io.
# {{ template "t" (list . "u_iploc") }}
function @ip-locator() {
    local USAGE="{{ template "t" (list . "u_iploc") }}"
    [ "$1" == "-h" ] && { echo "$USAGE" >&2; return; }
    [ $# -eq 0 ] && { echo "$USAGE" >&2; return; }
    while [ "$1" != "" ]; do
        curl -fsS "https://ipinfo.io/$1"
        shift
    done
}

# --- @ip-resolver ---
# Resolve o IP de um ou mais domínios usando o resolver da OpenDNS.
# {{ template "t" (list . "u_ipres") }}
function @ip-resolver() {
    local USAGE="{{ template "t" (list . "u_ipres") }}"
    [ "$1" == "-h" ] && { echo "$USAGE" >&2; return; }
    [ $# -eq 0 ] && { echo "$USAGE" >&2; return; }
    while [ "$1" != "" ]; do
        echo -n "$1 "
        dig +short @resolver1.opendns.com "$1"
        shift
    done
}

google() { ping -c 3 www.google.com.br; }
