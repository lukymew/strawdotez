# *********************************************
# * local: ${HOME}/.bashrc                   *
# * strawdotez • bash enxuto (Debian/Ubuntu)  *
# *********************************************

[ -z "$PS1" ] && return   # só em shell interativo

{ [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ] && [ -w "$TMPDIR" ]; } || export TMPDIR=/tmp
shopt -s checkwinsize
HISTSIZE=4000
HISTFILESIZE=5000
HISTCONTROL=ignoreboth

{{ template "env_common" . }}
{{ template "aliases_common" . }}
{{ template "aliases_termux" . }}
{{ template "functions_utils_termux" . }}
{{ template "functions_net_termux" . }}
{{ template "functions_ai_termux" . }}
{{ template "shell_tools_termux" . }}

# O script do straw usa o caminho do Termux no shebang; aqui ele roda pelo bash.
straw() { bash "$HOME/.local/bin/straw" "$@"; }

# cd lista a pasta ao entrar
cd() {
    if [ "$1" == ".." ]; then builtin cd .. && ls
    elif [ -n "$1" ]; then builtin cd "$1" && ls
    else builtin cd && ls
    fi
}

# PATH do usuário
[ -d "$HOME/.local/bin" ] && case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac

# Prompt colorido (mesmo visual do Termux)
if [[ ${EUID} == 0 ]]; then
    PS1='\[\033[01;31m\]┌─\[\033[01;34m\][\[\033[01;31m\]OS\[\033[01;34m\]@\[\033[01;31m\]\u\[\033[01;34m\]]\[\033[01;31m\]┉\[\033[01;34m\][\[\033[01;33m\]\t\[\033[01;34m\]]\n\[\033[01;31m\]└─\[\033[01;34m\][\[\033[01;32m\]\W\[\033[01;34m\]]\[\033[01;31m\]-\[\033[01;36m\] \[\033[0m\]'
else
    PS1='\[\033[01;31m\]┌─\[\033[01;34m\][\[\033[01;32m\]OS\[\033[01;34m\]@\[\033[01;32m\]\u\[\033[01;34m\]]\[\033[01;31m\]┉\[\033[01;34m\][\[\033[01;33m\]\t\[\033[01;34m\]]\n\[\033[01;31m\]└─\[\033[01;34m\][\[\033[01;32m\]\W\[\033[01;34m\]]\[\033[01;31m\]-\[\033[01;36m\] \[\033[0m\]'
fi

# --- Starship (opcional: straw config set prompt starship) ---
{{ if eq (index . "prompt" | default "default") "starship" -}}
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi
{{ end -}}
