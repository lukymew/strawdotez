mkcd() { mkdir -p "$1" && cd "$1"; }
extract() {
  if [ -f "$1" ]; then
    case "$1" in
      *.tar.gz)  tar xzf "$1" ;;
      *.tar.bz2) tar xjf "$1" ;;
      *.zip)     unzip "$1" ;;
      *.rar)     unrar x "$1" ;;
      *) echo "Formato não suportado: $1" ;;
    esac
  else
    echo "Arquivo não encontrado: $1"
  fi
}
