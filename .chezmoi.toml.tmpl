{{- /* alvo: termux, ou debian (Debian, Ubuntu, Kali via proot-distro ou nativo). STRAW_TARGET força um valor (testes). */ -}}
{{- $target := env "STRAW_TARGET" -}}
{{- if not $target -}}
{{-   if hasPrefix "/data/data/com.termux" (env "PREFIX") -}}
{{-     $target = "termux" -}}
{{-   else -}}
{{-     $os := index .chezmoi "osRelease" | default dict -}}
{{-     $ids := printf "%s %s" (index $os "id" | default "") (index $os "idLike" | default "") -}}
{{-     if or (contains "debian" $ids) (contains "ubuntu" $ids) -}}
{{-       $target = "debian" -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if not (has $target (list "termux" "debian")) -}}
{{-   fail "Ambiente não suportado: use o Termux (F-Droid) ou Debian/Ubuntu. Alpine ainda não. / Unsupported environment: use Termux (F-Droid) or Debian/Ubuntu. Alpine is not supported yet." -}}
{{- end -}}
{{- $lang := promptChoiceOnce . "lang" "Idioma / Language (pt or en)" (list "pt" "en") "en" -}}
{{- $t := dict
    "pt" (dict
        "intro" "\n=== strawdotez: configuração do Termux ===\nEnter aceita o padrão de cada pergunta.\n\n"
        "name" "Seu nome para o git (opcional: Enter pula)"
        "email" "Seu e-mail para o git (opcional: Enter pula)"
        "device" "Perfil do Termux (cell para celular ou tablet para tablet)"
        "shell" "Shell padrão do Termux (bash ou zsh)"
        "banner" "Mostrar o logo e o cabeçalho ao abrir o terminal? (Y/n)"
        "hush" "Desligar a mensagem de boas-vindas do Termux? (Y/n)")
    "en" (dict
        "intro" "\n=== strawdotez: Termux setup ===\nPress Enter to accept each default.\n\n"
        "name" "Your name for git (optional: Enter skips)"
        "email" "Your email for git (optional: Enter skips)"
        "device" "Termux profile (cell for phone or tablet for tablet)"
        "shell" "Default Termux shell (bash or zsh)"
        "banner" "Show the logo and header when the terminal opens? (Y/n)"
        "hush" "Turn off the Termux welcome message? (Y/n)") -}}
{{- $m := index $t $lang -}}
{{- writeToStdout (index $m "intro" | default (index $t "en" "intro")) -}}
{{- $name := promptStringOnce . "name" (index $m "name" | default (index $t "en" "name")) "" -}}
{{- $email := promptStringOnce . "email" (index $m "email" | default (index $t "en" "email")) "" -}}
{{- $device := "cell" -}}
{{- $shell := "bash" -}}
{{- $banner := true -}}
{{- $hush := true -}}
{{- if eq $target "termux" -}}
{{- $device = promptChoiceOnce . "device" (index $m "device" | default (index $t "en" "device")) (list "cell" "tablet") "cell" -}}
{{- $shell = promptChoiceOnce . "shell" (index $m "shell" | default (index $t "en" "shell")) (list "bash" "zsh") "bash" -}}
{{- $banner = promptBoolOnce . "banner" (index $m "banner" | default (index $t "en" "banner")) true -}}
{{- $hush = promptBoolOnce . "hushlogin" (index $m "hush" | default (index $t "en" "hush")) true -}}
{{- end -}}
{{- $font := index . "font" | default "default" -}}
{{- $theme := index . "theme" | default "default" -}}
{{- $prompt := index . "prompt" | default "default" -}}

[data]
    target = {{ $target | quote }}
    lang = {{ $lang | quote }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    device = {{ $device | quote }}
    shell = {{ $shell | quote }}
    font = {{ $font | quote }}
    theme = {{ $theme | quote }}
    prompt = {{ $prompt | quote }}
    banner = {{ $banner }}
    hushlogin = {{ $hush }}
