#!/data/data/com.termux/files/usr/bin/bash
# straw: comando do strawdotez. Uso: straw menu | install | tools | doctor | config | update | version | help
# shellcheck disable=SC2154  # as variáveis M_* vêm do messages.sh gerado pelo chezmoi
set -u
DATA="${STRAW_DIR:-$HOME/.local/share/strawdotez}"

if [ ! -r "$DATA/messages.sh" ]; then
    echo "straw: menu data not found / dados do menu não encontrados. Run: chezmoi apply" >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$DATA/messages.sh"

say() { printf '%s\n' "$1"; }
fmt() { printf '%s\n' "${1//%s/$2}"; }

# ---- ambiente: termux, apt (Debian, Ubuntu, Kali) ou apk (Alpine)
KEY="${STRAW_ENV:-}"
ENVNAME=""
if [ -z "$KEY" ]; then
    case "${PREFIX:-}" in /data/data/com.termux*) KEY=termux ;; esac
fi
if [ -z "$KEY" ] && [ -r /etc/os-release ]; then
    id="$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"')"
    like="$(sed -n 's/^ID_LIKE=//p' /etc/os-release | tr -d '"')"
    ENVNAME="$id"
    case "$id $like" in
        *alpine*)                    KEY=apk ;;
        *debian*|*ubuntu*|*kali*)    KEY=apt ;;
    esac
fi
case "$KEY" in
    termux) COL=3; ENVNAME=Termux ;;
    apt)    COL=4; : "${ENVNAME:=apt}" ;;
    apk)    COL=5; : "${ENVNAME:=alpine}" ;;
    *)      COL=0 ;;
esac

SUDO=()
if [ "$KEY" != termux ] && [ "$(id -u)" != 0 ] && command -v sudo >/dev/null 2>&1; then SUDO=(sudo); fi

pm_has() {
    case "$KEY" in
        apk) apk info -e "$1" >/dev/null 2>&1 ;;
        *)   [ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)" = "install ok installed" ] ;;
    esac
}
pm_install() {
    case "$KEY" in
        termux) pkg install -y "$@" ;;
        apt)    "${SUDO[@]+"${SUDO[@]}"}" apt-get install -y "$@" ;;
        apk)    "${SUDO[@]+"${SUDO[@]}"}" apk add "$@" ;;
    esac
}
pm_refresh() {
    case "$KEY" in
        apt) "${SUDO[@]+"${SUDO[@]}"}" apt-get update -qq ;;
        apk) "${SUDO[@]+"${SUDO[@]}"}" apk update -q ;;
    esac
}

installed() {
    local p
    for p in "$@"; do pm_has "$p" || return 1; done
    return 0
}

install_pkgs() {
    local falta=() falhou=() p
    for p in "$@"; do pm_has "$p" || falta+=("$p"); done
    if [ "${#falta[@]}" -eq 0 ]; then say "$M_nothing_to_install"; return 0; fi
    fmt "$M_installing" "${falta[*]}"
    pm_refresh
    if ! pm_install "${falta[@]}"; then
        for p in "${falta[@]}"; do
            pm_has "$p" && continue
            pm_install "$p" || falhou+=("$p")
        done
    fi
    if [ "${#falhou[@]}" -gt 0 ]; then
        printf '\n\033[33m%s\033[0m\n' "$M_failed"
        printf '  - %s\n' "${falhou[@]}"
    else
        say "$M_done"
    fi
}

col() { # arquivo id coluna
    awk -F'\t' -v id="$2" -v c="$3" '$1 == id { print $c }' "$1"
}

mod_pkgs() { # id -> pacotes do ambiente atual (vazio se o módulo não existe aqui)
    local v
    v="$(col "$DATA/modules.tsv" "$1" "$COL")"
    [ "$v" = "-" ] && v=""
    printf '%s' "$v"
}

pause() {
    if [ -t 0 ]; then read -r -p "$M_continue " _; fi
    return 0
}

ic() { [ "${STRAW_PLAIN:-0}" = 1 ] || printf '%s ' "$1"; }

pick() { # cabeçalho  (linhas "id<TAB>texto" no stdin; PICK_MULTI=1 liga a seleção múltipla)
    local opts=(--delimiter=$'\t' --with-nth=2 --header="$1" --prompt="straw> " --layout=reverse --height=~50%)
    [ "${PICK_MULTI:-0}" = 1 ] && opts+=(--multi)
    fzf "${opts[@]}" | cut -f1
}

menu_tools() {
    local lines id desc pk mark sel pkgs=() m
    lines="back"$'\t'"$(ic ⬅️)$M_back"$'\n'
    local icon group order
    for group in cli dev net; do
        while IFS=$'\t' read -r id desc _ _ _ icon order; do
            [ -z "$id" ] || [ "$order" != "$group" ] && continue
            pk="$(mod_pkgs "$id")"
            [ -z "$pk" ] && continue
            # shellcheck disable=SC2086
            if installed $pk; then mark="[x]"; else mark="[ ]"; fi
            [ "${STRAW_PLAIN:-0}" = 1 ] && icon=""
            lines+="$id"$'\t'"$mark ${icon:+$icon }$desc"$'\n'
        done < "$DATA/modules.tsv"
    done
    sel="$(printf '%s' "$lines" | PICK_MULTI=1 pick "$M_tools_header")"
    if [ -z "$sel" ] || printf '%s\n' "$sel" | grep -qx back; then return 0; fi
    while IFS= read -r id; do
        m="$(mod_pkgs "$id")"
        # shellcheck disable=SC2206
        pkgs+=($m)
    done <<< "$sel"
    install_pkgs "${pkgs[@]}"
    pause
}

menu_profiles() {
    local lines id desc only sel m pkgs=() mp icon
    lines="back"$'\t'"$(ic ⬅️)$M_back"$'\n'
    while IFS=$'\t' read -r id desc _ only icon; do
        [ -z "$id" ] && continue
        if [ "$only" != "-" ] && [[ ",$only," != *",$KEY,"* ]]; then continue; fi
        lines+="$id"$'\t'"$(ic "${icon:-📦}")$desc"$'\n'
    done < "$DATA/profiles.tsv"
    sel="$(printf '%s' "$lines" | pick "$M_profiles_header")"
    if [ -z "$sel" ] || [ "$sel" = back ]; then return 0; fi
    for m in $(col "$DATA/profiles.tsv" "$sel" 3); do
        [ "$m" = "-" ] && continue
        mp="$(mod_pkgs "$m")"
        # shellcheck disable=SC2206
        pkgs+=($mp)
    done
    if [ "${#pkgs[@]}" -eq 0 ]; then say "$M_nothing_to_install"; pause; return 0; fi
    install_pkgs "${pkgs[@]}"
    pause
}

menu_one() {
    local names
    read -r -p "$M_ask_pkgs " names || return 0
    if [ -z "$names" ]; then say "$M_nothing"; return 0; fi
    # shellcheck disable=SC2086
    install_pkgs $names
    pause
}

cmd_menu() {
    command -v fzf >/dev/null 2>&1 || { say "$M_need_fzf" >&2; return 1; }
    [ "$COL" -gt 0 ] || { say "$M_no_pm" >&2; return 1; }
    local sel head
    head="${M_menu_header//%s/$ENVNAME}"
    while :; do
        sel="$(printf 'tools\t%s%s\nprofiles\t%s%s\nbrowse\t%s%s\none\t%s%s\nconfig\t%s%s\nquit\t%s%s\n' \
            "$(ic 🧰)" "$M_menu_tools" "$(ic 🎭)" "$M_menu_profiles" "$(ic 🔎)" "$M_menu_browse" \
            "$(ic 📦)" "$M_menu_one" "$(ic ⚙️)" "$M_menu_config" "$(ic 👋)" "$M_quit" | pick "$head")"
        case "$sel" in
            tools)    menu_tools ;;
            profiles) menu_profiles ;;
            browse)   cmd_tools; pause ;;
            one)      menu_one ;;
            config)   cfg_menu ;;
            *)        return 0 ;;
        esac
    done
}

cmd_install() {
    [ "$COL" -gt 0 ] || { say "$M_no_pm" >&2; return 1; }
    if [ "$#" -eq 0 ]; then say "$M_install_usage" >&2; return 2; fi
    install_pkgs "$@"
}

cmd_help() {
    say "$M_help_title"
    say "$M_help_menu"
    say "$M_help_install"
    say "$M_help_tools"
    say "$M_help_doctor"
    say "$M_help_config"
    say "$M_help_update"
    say "$M_help_version"
    say "$M_help_help"
}

cmd_doctor() {
    local bin="${STRAW_UI:-$HOME/.local/bin/straw-ui}"
    if [ ! -x "$bin" ]; then
        command -v straw-ui >/dev/null 2>&1 && bin="$(command -v straw-ui)" || { say "$M_doctor_no_bin" >&2; return 1; }
    fi
    "$bin" doctor "$@"
}

cmd_tools() {
    local bin="${STRAW_UI:-$HOME/.local/bin/straw-ui}"
    [ -x "$bin" ] || bin="$(command -v straw-ui 2>/dev/null || true)"
    if [ -z "$bin" ]; then say "$M_doctor_no_bin" >&2; return 1; fi
    "$bin" tools "$@"
}

# ---- config: lê e grava as opções do chezmoi ([data] em chezmoi.toml) e aplica
CFG="${STRAW_CONFIG:-$HOME/.config/chezmoi/chezmoi.toml}"
CFG_KEYS="lang shell font theme prompt device banner hushlogin name email"

cfg_has_key() { case " $CFG_KEYS " in *" $1 "*) return 0 ;; esac; return 1; }

# valores permitidos de uma opção, um por linha; vazio = texto livre
cfg_opts() {
    case "$1" in
        lang)             printf 'pt\nen\n' ;;
        shell)            printf 'bash\nzsh\n' ;;
        device)           printf 'cell\ntablet\n' ;;
        prompt)           printf 'default\nstarship\n' ;;
        banner|hushlogin) printf 'true\nfalse\n' ;;
        font)             cut -f1 "$DATA/fonts.tsv" 2>/dev/null ;;
        theme)            cut -f1 "$DATA/themes.tsv" 2>/dev/null ;;
    esac
}

cfg_get() {
    local v
    v="$(sed -n "/^\[data\]/,\$ { s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p; }" "$CFG" 2>/dev/null | head -n 1)"
    v="${v#\"}"; v="${v%\"}"
    if [ -z "$v" ]; then
        case "$1" in shell) v=bash ;; font|theme|prompt) v=default ;; esac
    fi
    printf '%s\n' "$v"
}

# grava uma opção no [data]; valida a chave e o valor
cfg_set() {
    local k="$1" v="$2" lit out opts
    cfg_has_key "$k" || { fmt "$M_cfg_unknown" "$k" >&2; return 2; }
    [ -f "$CFG" ] || { say "$M_cfg_nofile" >&2; return 1; }
    opts="$(cfg_opts "$k")"
    if [ -n "$opts" ]; then
        printf '%s\n' "$opts" | grep -qxF -- "$v" || { fmt "$M_cfg_invalid" "$k=$v" >&2; return 2; }
    else
        case "$v" in *\"*|*\\*|*[[:cntrl:]]*) fmt "$M_cfg_invalid" "$k" >&2; return 2 ;; esac
    fi
    case "$k" in
        banner|hushlogin) lit="$v" ;;
        *)                lit="\"$v\"" ;;
    esac
    if grep -Eq "^[[:space:]]*${k}[[:space:]]*=" "$CFG"; then
        out="$(awk -v k="$k" -v v="$lit" '$0 ~ "^[ \t]*" k "[ \t]*=" { print "    " k " = " v; next } { print }' "$CFG")"
    else
        out="$(awk -v k="$k" -v v="$lit" '{ print } /^\[data\]/ && !d { print "    " k " = " v; d=1 }' "$CFG")"
    fi
    printf '%s\n' "$out" > "$CFG"
}

cfg_label() { local n="M_cfg_$1"; printf '%s' "${!n}"; }

cfg_show() { # chave valor -> texto legível
    case "$1" in
        banner|hushlogin) if [ "$2" = true ]; then printf '%s' "$M_cfg_on"; else printf '%s' "$M_cfg_off"; fi ;;
        font|theme)       awk -F'\t' -v id="$2" '$1 == id { print $2; f=1 } END { if (!f) print id }' "$DATA/$1s.tsv" 2>/dev/null ;;
        *)                printf '%s' "$2" ;;
    esac
}

cfg_list() {
    local k
    for k in $CFG_KEYS; do
        printf '%s\t%s\n' "$k" "$(cfg_get "$k")"
    done
}

cfg_change() { # chave valor: grava e aplica
    cfg_set "$1" "$2" || return $?
    fmt "$M_cfg_saved" "$1=$2"
    if [ "$1" = prompt ] && [ "$2" = starship ] && ! command -v starship >/dev/null 2>&1; then
        fmt "$M_installing" starship
        pm_install starship || say "$M_failed starship" >&2
    fi
    [ "${STRAW_NO_APPLY:-0}" = 1 ] && return 0
    say "$M_cfg_applying"
    # tema e fonte são copiados por um script; o chezmoi estranha o arquivo e pergunta se pode
    # sobrescrever. Sem o arquivo, ele só grava o que for preciso (sem perguntas).
    case "$1" in
        theme) rm -f "$HOME/.termux/colors.properties" ;;
        font)  rm -f "$HOME/.termux/font.ttf" ;;
    esac
    if chezmoi apply; then say "$M_cfg_restart"; else say "$M_cfg_noapply" >&2; return 1; fi
}

cfg_menu() {
    command -v fzf >/dev/null 2>&1 || { say "$M_need_fzf" >&2; return 1; }
    [ -f "$CFG" ] || { say "$M_cfg_nofile" >&2; return 1; }
    local k v sel lines
    while :; do
        lines="back"$'\t'"$(ic ⬅️)$M_back"$'\n'
        for k in $CFG_KEYS; do
            lines+="$k"$'\t'"$(cfg_label "$k"): $(cfg_show "$k" "$(cfg_get "$k")")"$'\n'
        done
        sel="$(printf '%s' "$lines" | pick "$M_cfg_header")"
        case "$sel" in ""|back) return 0 ;; esac
        if [ -n "$(cfg_opts "$sel")" ]; then
            lines=""
            while IFS= read -r v; do
                lines+="$v"$'\t'"$(cfg_show "$sel" "$v")"$'\n'
            done < <(cfg_opts "$sel")
            v="$(printf '%s' "$lines" | pick "$(cfg_label "$sel")")"
        else
            read -r -p "$(fmt "$M_cfg_ask" "$(cfg_label "$sel")") " v || return 0
        fi
        [ -n "$v" ] && { cfg_change "$sel" "$v"; pause; }
    done
}

cmd_config() {
    case "${1:-}" in
        "")   if [ -t 0 ] && [ -t 1 ]; then cfg_menu; else cfg_list; fi ;;
        list) cfg_list ;;
        get)  cfg_has_key "${2:-}" || { fmt "$M_cfg_unknown" "${2:-}" >&2; return 2; }; cfg_get "$2" ;;
        set)  [ "$#" -ge 3 ] || { say "$M_cfg_usage" >&2; return 2; }; cfg_change "$2" "$3" ;;
        *)    say "$M_cfg_usage" >&2; return 2 ;;
    esac
}

# ---- update: atualiza os arquivos (chezmoi) e o binário straw-ui da última release
UI_REPO="${STRAW_REPO:-lukymew/strawdotez}"

# versão fixada = clone do chezmoi em HEAD solto (instalado com --version)
update_pinned() {
    [ "${STRAW_PINNED:-}" = 1 ] && return 0
    [ "${STRAW_PINNED:-}" = 0 ] && return 1
    local src
    src="$(chezmoi source-path 2>/dev/null)" || return 1
    git -C "$src" rev-parse --git-dir >/dev/null 2>&1 || return 1
    ! git -C "$src" symbolic-ref -q HEAD >/dev/null 2>&1
}

update_ui() {
    local arch base dest tmp want have got
    case "$(uname -m)" in
        aarch64|arm64) arch=arm64 ;;
        x86_64|amd64)  arch=amd64 ;;
        *) return 0 ;;
    esac
    if update_pinned; then say "$M_update_ui_pinned"; return 0; fi
    base="${STRAW_UI_URL:-https://github.com/$UI_REPO/releases/latest/download}"
    dest="$HOME/.local/bin/straw-ui"
    tmp="$(mktemp -d "${TMPDIR:-$HOME}/straw-ui.XXXXXX")" || return 1
    if curl -fsSL "$base/SHA256SUMS" -o "$tmp/sums"; then
        want="$(awk -v f="straw-ui-linux-$arch" '$2 == f { print $1 }' "$tmp/sums")"
        have=""
        [ -f "$dest" ] && have="$(sha256sum "$dest" | cut -d' ' -f1)"
        if [ -n "$want" ] && [ "$want" = "$have" ]; then
            say "$M_update_ui_current"; rm -rf "$tmp"; return 0
        fi
        if [ -n "$want" ] && curl -fsSL "$base/straw-ui-linux-$arch" -o "$tmp/bin"; then
            got="$(sha256sum "$tmp/bin" | cut -d' ' -f1)"
            if [ "$got" = "$want" ]; then
                mkdir -p "$HOME/.local/bin"
                install -m 755 "$tmp/bin" "$dest"
                say "$M_update_ui_ok"; rm -rf "$tmp"; return 0
            fi
        fi
    fi
    rm -rf "$tmp"
    say "$M_update_ui_fail" >&2
    return 1
}

cmd_update() {
    chezmoi update || return $?
    update_ui
}

cmd_version() {
    local v
    v="$(git -C "$(chezmoi source-path 2>/dev/null)" describe --tags 2>/dev/null)"
    say "strawdotez ${v:-?}"
}

case "${1:-}" in
    menu)                 cmd_menu ;;
    install)              shift; cmd_install "$@" ;;
    tools)                shift; cmd_tools "$@" ;;
    doctor)               shift; cmd_doctor "$@" ;;
    config)               shift; cmd_config "$@" ;;
    update)               cmd_update; exit $? ;;
    version|-v|--version) cmd_version ;;
    help|-h|--help)       cmd_help ;;
    "")                   if [ -t 0 ] && [ -t 1 ] && command -v fzf >/dev/null 2>&1; then cmd_menu; else cmd_help; fi ;;
    *)                    fmt "$M_unknown" "$1" >&2; cmd_help >&2; exit 2 ;;
esac
