### PERFIL: TABLET
### Ativado via função termux-modo-tablet (ver .bashrc) ou: straw config set device tablet
### Para voltar ao celular, rode: termux-modo-celular
###
### After making changes and saving you need to run `termux-reload-settings`
### to update the terminal. All information here can also be found on the
### wiki: https://wiki.termux.com/wiki/Terminal_Settings

# =====================================================
# 1. GERAL (General)
# =====================================================

### Allow external applications to execute arbitrary commands within Termux.
### This potentially could be a security issue, so option is disabled by
### default. Uncomment to enable.
# Desligado por padrão: ligar deixa apps com a permissão RUN_COMMAND rodarem comandos aqui (veja SECURITY.md).
# Usa Tasker ou automação? Troque por true e rode termux-reload-settings.
allow-external-apps = false

### Default working directory that will be used when launching the app.
# default-working-directory = /data/data/com.termux/files/home/Workspace

### Uncomment to disable toasts shown on terminal session change.
disable-terminal-session-change-toast = true

### Teclado touch não sobe ao abrir o Termux (toque no ícone de teclado para abri-lo)
hide-soft-keyboard-on-startup = true

### enable: o botão de teclado só mostra/esconde (igual ao celular)
soft-keyboard-toggle-behaviour = enable

### Tela grande mostra mais linhas de uma vez — buffer maior
### (máximo 50000; valores muito altos podem pesar no desempenho)
terminal-transcript-rows = 10000

### Tablet: libera o volume normal. Com "volume" os atalhos Volume+Q/K/L deixam
### de funcionar (use os botões da extra-keys). Para usar o volume como tecla
### extra, comente a linha abaixo.
volume-keys = volume

# =====================================================
# 2. TELA CHEIA (Fullscreen mode)
# =====================================================

### Tablet aproveita bem o modo imersivo
fullscreen = true

### Contorna problemas de layout no modo tela cheia
use-fullscreen-workaround = true

# =====================================================
# 3. CURSOR
# =====================================================

### Cursor blink rate. Values 0, 100 - 2000.
terminal-cursor-blink-rate = 500

### Cursor style: block, bar, underline.
### Estilo "bar" combina melhor com uso prolongado em tela grande
terminal-cursor-style = bar

# =====================================================
# 4. EXTRA KEYS (teclas extras)
# =====================================================

### Settings for choosing which set of symbols to use for illustrating keys.
### Choose between default, arrows-only, arrows-all, all and none
extra-keys-style = all

### Mesmo estilo do celular. Alternativas: "arrows-only" (mais discreto) ou "all" (símbolos em todas as teclas).
# extra-keys-style = arrows-only
# extra-keys-style = all

### Force capitalize all text in extra keys row button labels.
extra-keys-text-all-caps = true

### Default extra-key configuration
# extra-keys = [[ESC, TAB, CTRL, ALT, {key: '-', popup: '|'}, DOWN, UP]]

### Layout do tablet: o mesmo do celular (2 linhas) com 2 teclas a mais por linha,
### 10 por linha para ficar proporcional. Extras: HOME, / (deslizar: ~), SHFT e - (deslizar: |).
### Deslizar para cima numa tecla com popup dispara a segunda função:
###   ESC → gaveta (DRAWER) | / → ~ | - → | | KEYBOARD → CTRL+d (sair do shell)
### SHFT precisa do Termux 0.118 ou mais novo. Outras teclas úteis para trocar:
### INS, FN, '_', PGUP/PGDN, F1-F12.
extra-keys = [ \
    [{key: ESC, popup: DRAWER},'BKSP','DEL','PASTE','HOME','UP','END','PGUP',{key: '/', popup: '~'},{key: KEYBOARD, popup: {macro: "CTRL d", display: exit}}], \
    ['TAB','CTRL','ALT','SHFT','LEFT','DOWN','RIGHT','PGDN',{key: '-', popup: '|'},'ENTER'] \
]

### Alternativa para quem usa vim: salvar e sair com um toque (ou deslizando).
### Cada macro manda as teclas em sequência (ESC :w ENTER = salvar).
# extra-keys = [ \
#     [{key: ESC, popup: {macro: "ESC :q ENTER", display: ":q"}},{macro: "ESC :w ENTER", display: ":w"},{macro: "ESC :wq ENTER", display: ":wq"},'/','-','HOME','UP','END','PGUP','BKSP','DEL'], \
#     ['TAB','CTRL','ALT','SHIFT','LEFT','DOWN','RIGHT','PGDN','PASTE',{key: KEYBOARD, popup: {macro: "CTRL d", display: exit}},'ENTER'] \
# ]

### Alternativa com popups voltados para uso com tmux (prefixo CTRL f)
# extra-keys = [[ \
#   {key: ESC, popup: {macro: "CTRL f d", display: "tmux exit"}}, \
#   {key: CTRL, popup: {macro: "CTRL f BKSP", display: "tmux ←"}}, \
#   {key: ALT, popup: {macro: "CTRL f TAB", display: "tmux →"}}, \
#   {key: TAB, popup: {macro: "ALT a", display: A-a}}, \
#   {key: LEFT, popup: HOME}, \
#   {key: DOWN, popup: PGDN}, \
#   {key: UP, popup: PGUP}, \
#   {key: RIGHT, popup: END}, \
#   {macro: "ALT j", display: A-j, popup: {macro: "ALT g", display: A-g}}, \
#   {key: KEYBOARD, popup: {macro: "CTRL d", display: exit}} \
# ]]

# =====================================================
# 5. CORES / TEMA (Colors/themes)
# =====================================================

### Force black colors for drawer and dialogs
use-black-ui = true

# =====================================================
# 6. ATALHOS DE TECLADO FÍSICO (HW keyboard shortcuts)
# =====================================================

### Tablet: teclado bluetooth físico é mais comum, atalhos fazem sentido.
### Com os atalhos ligados o Termux também responde a (CTRL+ALT+...):
###   C nova sessão, R renomear, V colar, +/- tamanho da fonte, 1-9 ir para a sessão.
disable-hardware-keyboard-shortcuts = false

### Open a new terminal with ctrl + t
shortcut.create-session = ctrl + t

### Go one session down with (for example) ctrl + 2
shortcut.next-session = ctrl + 2

### Go one session up with (for example) ctrl + 1
shortcut.previous-session = ctrl + 1

### Rename a session with (for example) ctrl + n
shortcut.rename-session = ctrl + n

# =====================================================
# 7. TECLA BELL (Bell key)
# =====================================================

### Vibrate device (default).
# bell-character = vibrate

### Beep with a sound.
### Tablet fica mais em mesa/suporte — som é aceitável e perceptível
bell-character = beep

### Ignore bell character.
# bell-character = ignore

# =====================================================
# 8. TECLA VOLTAR (Back key)
# =====================================================

### Send the Escape key.
# back-key=escape

### Hide keyboard or leave app (default).
back-key=back

# =====================================================
# 9. WORKAROUNDS DE TECLADO (Keyboard issue workarounds)
# =====================================================

### Letters might not appear until enter is pressed on Samsung devices
# enforce-char-based-input = true

### ctrl+space (for marking text in emacs) does not work on some devices.
### Evita o bug do ctrl+space com teclado bluetooth (útil em vim/emacs)
ctrl-space-workaround = true

# =====================================================
# 10. MARGENS DO TERMINAL (Terminal Margin adjustments)
# =====================================================

### Horizontal (left/right) Margin — tela larga sem margem cansa a vista
terminal-margin-horizontal=8

### Vertical (top/bottom) Margin
terminal-margin-vertical=4
