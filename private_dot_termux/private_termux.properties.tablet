### PERFIL: TABLET
### Ativado via função termux-modo-tablet (ver .bashrc)
### Para voltar ao celular, rode: termux-modo-celular
###
### After making changes and saving you need to run `termux-reload-settings`
### to update the terminal. All information here can also be found on the
### wiki: https://wiki.termux.com/wiki/Terminal_Settings

# =====================================================
# 1. GERAL (General)
# =====================================================

allow-external-apps = true

### Tablet costuma ser usado com projeto fixo — descomente e ajuste
### se você sempre abre trabalhando na mesma pasta
# default-working-directory = /data/data/com.termux/files/home/Workspace

disable-terminal-session-change-toast = true

### Tablet geralmente usa teclado físico bluetooth com mais frequência —
### não esconder o teclado touch por padrão evita ficar chamando ele à toa
hide-soft-keyboard-on-startup = false

soft-keyboard-toggle-behaviour = enable/disable

### Buffer maior — tela grande mostra mais linhas de uma vez,
### então vale guardar mais histórico de saída
terminal-transcript-rows = 10000

### Libera teclas de volume pra função normal, já que a extra-keys
### row tem espaço de sobra na tela grande
volume-keys = volume

# =====================================================
# 2. TELA CHEIA (Fullscreen mode)
# =====================================================

### Tablet aproveita bem o modo imersivo — mais espaço útil de terminal
fullscreen = true

use-fullscreen-workaround = true

# =====================================================
# 3. CURSOR
# =====================================================

terminal-cursor-blink-rate = 500

### Estilo "bar" (tipo cursor de editor de texto) é mais discreto
### e combina bem com uso prolongado em tela grande
terminal-cursor-style = bar

# =====================================================
# 4. EXTRA KEYS (teclas extras)
# =====================================================

extra-keys-style = all

extra-keys-text-all-caps = true

### Mais teclas visíveis de uma vez, já que sobra espaço horizontal
extra-keys = [ \
    [{key: ESC, popup: DRAWER},'1','2','3','4','5','6','7','8','9','0'], \
    ['TAB','CTRL','ALT','FN','HOME','UP','END','PGUP','INS','BKSP','DEL'], \
    ['|','/','-','_','LEFT','DOWN','RIGHT','PGDN','PASTE','KEYBOARD'] \
]

# =====================================================
# 5. CORES / TEMA (Colors/themes)
# =====================================================

use-black-ui = true

# =====================================================
# 6. ATALHOS DE TECLADO FÍSICO (HW keyboard shortcuts)
# =====================================================

### Tablet costuma usar teclado bluetooth físico — atalhos ativos
### fazem muito mais sentido aqui do que no celular
disable-hardware-keyboard-shortcuts = false

shortcut.create-session = ctrl + t

shortcut.next-session = ctrl + 2

shortcut.previous-session = ctrl + 1

shortcut.rename-session = ctrl + n

# =====================================================
# 7. TECLA BELL (Bell key)
# =====================================================

### Tablet fica mais em mesa/suporte — som é aceitável e mais perceptível
bell-character = beep

# =====================================================
# 8. TECLA VOLTAR (Back key)
# =====================================================

back-key=back

# =====================================================
# 9. WORKAROUNDS DE TECLADO (Keyboard issue workarounds)
# =====================================================

# enforce-char-based-input = true

### Se usar teclado físico bluetooth e mexer com emacs/vim,
### esse workaround evita bug do ctrl+space em alguns aparelhos
ctrl-space-workaround = true

# =====================================================
# 10. MARGENS DO TERMINAL (Terminal Margin adjustments)
# =====================================================

### Margem lateral maior — tela larga sem margem cansa a vista
terminal-margin-horizontal=8

### Margem vertical levemente maior para conforto visual
terminal-margin-vertical=4
