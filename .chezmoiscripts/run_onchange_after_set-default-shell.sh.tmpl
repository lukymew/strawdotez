#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

{{- $shell := index . "shell" | default "bash" }}
# shell padrão: {{ $shell }}
want="{{ $shell }}"
if ! command -v "$want" >/dev/null 2>&1; then
    echo "{{ template "t" (list . "shell_missing") }} ($want)" >&2
    exit 0
fi
if command -v chsh >/dev/null 2>&1 && chsh -s "$want" >/dev/null 2>&1; then
    echo "{{ template "t" (list . "shell_set") }} ($want)"
fi
