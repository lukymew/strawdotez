{{- if eq (index . "target" | default "termux") "termux" -}}
#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

target="${PREFIX}/etc/bash.bashrc"

# backup unico (a funcao crb usa este arquivo para restaurar)
if [ -f "$target" ] && [ ! -f "${target}.bkp" ]; then
    cp "$target" "${target}.bkp"
fi

cat > "$target" <<'STRAW_BASHRC_EOF'
{{ template "bash.bashrc_termux" . }}
STRAW_BASHRC_EOF
{{- end }}
