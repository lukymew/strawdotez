#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

# profile: {{ include (printf "private_dot_termux/private_termux.properties.%s" .device) | sha256sum }}
# colors:  {{ include "private_dot_termux/private_colors.properties" | sha256sum }}
# font:    {{ include "private_dot_termux/private_font.ttf" | sha256sum }}

profile="$HOME/.termux/termux.properties.{{ .device }}"
active="$HOME/.termux/termux.properties"
if [ -f "$profile" ]; then
    # guarda as edições manuais antes de sobrescrever
    if [ -f "$active" ] && ! cmp -s "$profile" "$active"; then
        cp "$active" "$active.bak"
        echo "{{ template "t" (list . "props_backup") }}"
    fi
    cp "$profile" "$active"
fi

if command -v termux-reload-settings >/dev/null 2>&1; then
    termux-reload-settings || true
fi
