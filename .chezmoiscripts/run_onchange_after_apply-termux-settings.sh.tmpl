#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

# profile: {{ include (printf "private_dot_termux/private_termux.properties.%s" .device) | sha256sum }}
# colors:  {{ include "private_dot_termux/private_colors.properties" | sha256sum }}
# font:    {{ include "private_dot_termux/private_font.ttf" | sha256sum }}
{{- $font := index . "font" | default "default" }}
# fonte escolhida: {{ $font }}{{ range .fonts }}{{ if and (eq .id $font) (hasKey . "sha256") }} {{ .sha256 }}{{ end }}{{ end }}

profile="$HOME/.termux/termux.properties.{{ .device }}"
active="$HOME/.termux/termux.properties"
if [ -f "$profile" ]; then
    # guarda as edições manuais antes de sobrescrever
    if [ -f "$active" ] && ! cmp -s "$profile" "$active"; then
        cp "$active" "$active.bak"
        echo "{{ template "t" (list . "props_backup") }}"
    fi
    cp "$profile" "$active"
fi

{{- $theme := index . "theme" | default "default" }}
# tema escolhido: {{ $theme }}{{ range .themes }}{{ if and (eq .id $theme) (hasKey . "sha256") }} {{ .sha256 }}{{ end }}{{ end }}
{{ if ne $theme "default" -}}
themesrc="$HOME/.local/share/strawdotez/colors.properties"
if [ -f "$themesrc" ]; then
    mkdir -p "$HOME/.termux"
    cp "$themesrc" "$HOME/.termux/colors.properties"
fi

{{ end -}}
{{ if ne $font "default" -}}
fontsrc="$HOME/.local/share/strawdotez/font.ttf"
if [ -f "$fontsrc" ]; then
    mkdir -p "$HOME/.termux"
    cp "$fontsrc" "$HOME/.termux/font.ttf"
fi

{{ end -}}
if command -v termux-reload-settings >/dev/null 2>&1; then
    termux-reload-settings || true
fi
