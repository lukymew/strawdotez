#!{{ env "PREFIX" }}/bin/bash
# strawdotez: instala os pacotes do Termux (lista em .chezmoidata/packages.yaml)
pkgs=({{ join " " .packages.termux }})

# só conta como instalado o pacote no estado "install ok installed" (dpkg -s também aceita removidos com configuração)
instalado() { [ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)" = "install ok installed" ]; }

printf '{{ template "t" (list . "pkg_checking") }}\n' "${#pkgs[@]}"
faltando=()
for p in "${pkgs[@]}"; do
    instalado "$p" || faltando+=("$p")
done

falhou=()
if [ "${#faltando[@]}" -gt 0 ]; then
    printf '{{ template "t" (list . "pkg_installing") }}\n' "${#faltando[@]}"
    if ! pkg install -y "${faltando[@]}"; then
        for p in "${faltando[@]}"; do
            instalado "$p" && continue
            pkg install -y "$p" || falhou+=("$p")
        done
    fi
fi

if [ "${#falhou[@]}" -gt 0 ]; then
    printf '\n\033[33m{{ template "t" (list . "pkg_failed") }}\033[0m\n' "${#falhou[@]}"
    printf '  - %s\n' "${falhou[@]}"
    printf '{{ template "t" (list . "pkg_hint") }}\n\n'
fi
exit 0
