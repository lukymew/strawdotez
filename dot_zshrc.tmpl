{{ template "env_common" . }}
{{ template "aliases_common" . }}
{{ template "zsh_compat_termux" . }}
{{ if ne (index . "target" | default "termux") "termux" -}}
straw() { bash "$HOME/.local/bin/straw" "$@"; }
{ [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ] && [ -w "$TMPDIR" ]; } || export TMPDIR=/tmp
{{ end -}}
{{ template "shell_common_termux" . }}
{{ template "shell_tools_termux" . }}
{{ template "zsh_opts_termux" . }}
{{ template "zsh_prompt_termux" . }}
{{ template "zsh_plugins_termux" . }}
{{ if eq (index . "prompt" | default "default") "starship" -}}
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi
{{ end -}}
